# ─── KUBICO Backend — variáveis de ambiente ─────────────────────────────────
# Copia este ficheiro para .env e preenche os valores reais.

# Base de dados
DATABASE_URL=postgresql://kubico:kubico@db:5432/kubico

# Segurança JWT — gera com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-chave-secreta-forte
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Admin — chave para auto-promoção a admin no setup inicial
ADMIN_SETUP_KEY=troque-esta-chave-admin-no-env

# Verificação OTP
VERIFICATION_CODE_EXPIRE_MINUTES=10
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_CODE_RESEND_SECONDS=60

# Email SMTP (ex: Gmail, Mailgun, Brevo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@kubico.ao
SMTP_PASSWORD=
EMAIL_FROM=noreply@kubico.ao

# SMS (gateway angolano — ex: Movitel, Unitel API)
SMS_API_KEY=
SMS_SENDER_ID=KUBICO

# S3 / MinIO / Cloudflare R2 (imagens e vídeos)
# Deixa em branco para usar disco local em dev
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=af-south-1
S3_ENDPOINT_URL=
S3_PUBLIC_URL_BASE=
MAX_UPLOAD_SIZE_MB=50
MAX_VIDEO_SIZE_MB=80

# Upload local (fallback dev)
LOCAL_UPLOAD_DIR=/tmp/kubico_uploads
LOCAL_UPLOAD_PUBLIC_BASE=/uploads

# Preços dos destaques pagos (em AOA)
DESTAQUE_PRECO_7_DIAS=1500.0
DESTAQUE_PRECO_15_DIAS=2500.0
DESTAQUE_PRECO_30_DIAS=4000.0

# Plano agente mensal (em AOA)
PLANO_AGENTE_PRECO_MENSAL=8000.0

# ProxyPay / Multicaixa Express
PROXYPAY_BASE_URL=https://api.proxypay.co.ao
PROXYPAY_BEARER_TOKEN=
PROXYPAY_POS_ID=
